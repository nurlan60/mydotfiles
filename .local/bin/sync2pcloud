#!/bin/zsh
echo "Syncing Documents to PCloud"
rclone sync ~/Documents pcloud:/"My Documents"

echo "Syncing Narxoz to PCloud"
rclone sync "/Users/nurlan/OneDrive - Некоммерческое Акционерное Общество Университет Нархоз" pcloud:/Narxoz

echo "Syncing Documents to PSpace"
rclone sync ~/Documents pspace:
echo "Done"


